<Window x:Class="AWM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AWM — 블로그 초안" Height="720" Width="1100" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="300" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 입력 -->
        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel LastChildFill="False">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="설정" Command="{Binding OpenSettingsCommand}" Padding="12,2"
                            ToolTip="글 분량·말투·태그 개수·초안 저장 위치" />
                    <TextBlock Text="입력" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="주제 (필수)" Style="{StaticResource FieldLabel}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                <TextBlock DockPanel.Dock="Top" Text="키워드 (선택)" Style="{StaticResource FieldLabel}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                <TextBlock DockPanel.Dock="Top" Text="추가 요청 (선택)" Style="{StaticResource FieldLabel}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Extra, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                         Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                <!-- 사진: 넣고 글쓰기(사진 먼저) / 쓴 글에 배치(글 먼저) -->
                <DockPanel DockPanel.Dock="Top" Margin="0,12,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="사진 추가" Command="{Binding AddPhotosCommand}" Padding="10,2" />
                        <Button Content="사진 배치" Command="{Binding PlacePhotosCommand}" Padding="10,2" Margin="6,0,0,0"
                                ToolTip="Claude 가 사진을 보고, 글은 그대로 둔 채 어울리는 문단 뒤에 사진 줄을 넣습니다" />
                    </StackPanel>
                    <TextBlock Text="{Binding PhotosHeader}" Foreground="#555555" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Photos}" MaxHeight="140" MinHeight="28"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="빼기" Command="{Binding RemoveCommand}" Padding="8,0" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#333333" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaced}" Value="False">
                                                    <Setter Property="Foreground" Value="#B26A00" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="#C62828" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="초안 만들기" Command="{Binding GenerateCommand}" Padding="0,8" IsDefault="True" />
                    <Button Grid.Column="2" Content="취소" Command="{Binding CancelCommand}" Padding="16,8" />
                </Grid>

                <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" Foreground="#888888" TextWrapping="Wrap"
                           Text="사진을 넣고 「초안 만들기」를 누르면 Claude 가 사진을 보고 글을 씁니다. 이미 쓴 글에는 「사진 배치」." />
            </DockPanel>
        </Border>

        <!-- 결과 -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 제목 줄과 버튼 줄을 나눈다 — 한 줄에 두면 창이 좁을 때 버튼이 제목을 덮는다. 버튼은 모자라면 다음 줄로 -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="결과 — 직접 고칠 수 있습니다" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding CurrentLabel}" Foreground="#666666" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentLabel}" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="네이버로 보내기" Command="{Binding SendToNaverCommand}" Padding="12,4" Margin="0,4,6,0"
                            ToolTip="크롬으로 네이버 글쓰기를 열고 단축키 Ctrl+Alt+V 를 10분 동안 켭니다" />
                    <Button Content="다시 붙이기" Command="{Binding RearmCommand}" Padding="10,4" Margin="0,4,18,0"
                            ToolTip="크롬을 새로 열지 않고 단축키만 다시 켭니다 — 열어 둔 글쓰기 탭에서 다시 붙일 때" />
                    <Button Content="불러오기" Command="{Binding OpenListCommand}" Padding="12,4" Margin="0,4,6,0" />
                    <Button Content="저장" Command="{Binding SaveCommand}" Padding="16,4" Margin="0,4,0,0" />
                </WrapPanel>
            </StackPanel>

            <DockPanel Grid.Row="1">
                <Button DockPanel.Dock="Right" Content="복사" Command="{Binding CopyTitleCommand}" Style="{StaticResource CopyButton}" />
                <TextBlock Text="제목" Style="{StaticResource FieldLabel}" />
            </DockPanel>
            <TextBox Grid.Row="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

            <DockPanel Grid.Row="3">
                <Button DockPanel.Dock="Right" Content="복사" Command="{Binding CopyBodyCommand}" Style="{StaticResource CopyButton}"
                        ToolTip="소제목·인용·목록 서식을 살린 본문과 태그를 복사합니다(사진 제외). 서식 없이 붙이려면 붙일 곳에서 Ctrl+Shift+V" />
                <TextBlock Text="본문 (## 소제목 · &gt; 인용 · - 목록 · --- 구분선 · [사진: 설명 | 01.jpg])" Style="{StaticResource FieldLabel}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox Grid.Row="4" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <DockPanel Grid.Row="5">
                <TextBlock Text="태그 (본문 복사 때 맨 아래에 함께 붙습니다)" Style="{StaticResource FieldLabel}" />
            </DockPanel>
            <TextBox Grid.Row="6" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Padding="4" TextWrapping="Wrap" />
        </Grid>

        <!-- 상태 줄 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#444444" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#C62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
