<Window x:Class="TextBean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TextBean.ViewModels"
        xmlns:platform="clr-namespace:TextBean.Views.Platform"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="TextBean" Width="1000" Height="640">
  <!-- 트리 아이콘. 이미지 파일이 아니라 벡터로 둔다 —
       단일 파일 게시라 이미지가 들어가면 빌드 설정(Resource/Content)에 묶이고,
       그게 조용히 빠지면 아이콘만 안 뜨면서 빌드는 통과한다. 벡터는 DPI 도 안 탄다.
       창 안에 두는 이유: App.xaml 에 두면 창을 따로 띄우는 검증 프로브가 전부 깨진다. -->
  <Window.Resources>
    <DrawingImage x:Key="FolderIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- 세 아이콘이 같은 경계 상자를 쓰게 못 박는다.
               Image 는 Stretch=Uniform 이 기본이라 DrawingImage 자신의 경계 상자를 16x16 에 맞춰 늘린다.
               상자가 제각각이면 배율도 달라져, 같은 좌표에 그린 도형이 화면에서는 어긋난다 —
               자물쇠 배지가 상자를 x=15.2 까지 넓히는 바람에 폴더 x1.333 / 자물쇠 문서 x1.168 /
               평문 문서 x1.240 로 셋이 전부 달랐고, 두 문서가 크기도 위치도 안 맞았다 [실측].
               투명한 도형도 경계 계산에는 들어가므로 이 한 줄이면 배율이 전부 x1.000 이 된다.
               상자는 세 아이콘을 모두 감싸는 최소 크기다 — 바꾸려면 반드시 세 곳을 함께 바꾼다. -->
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,1.5,13.2,13.7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#73B4B2A9"
                           Geometry="M2,4.2 A1.2,1.2 0 0 1 3.2,3 H6.1 C6.5,3 6.9,3.2 7.1,3.5 L7.9,4.6 H12.8 A1.2,1.2 0 0 1 14,5.8 V12.2 A1.2,1.2 0 0 1 12.8,13.4 H3.2 A1.2,1.2 0 0 1 2,12.2 Z" />
          <GeometryDrawing Brush="#888780"
                           Geometry="M2,6.6 H14 V12.2 A1.2,1.2 0 0 1 12.8,13.4 H3.2 A1.2,1.2 0 0 1 2,12.2 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 문서 본체는 옅은 면, 접힌 모서리는 진한 면, 오른쪽 아래에 자물쇠 배지.
         얇은 선으로 그리면 16px 로 줄일 때 뭉갠다 — 면으로 채워야 형태가 남는다. -->
    <DrawingImage x:Key="DocumentLockedIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- 경계 상자 통일. 이유는 FolderIcon 의 주석 참조 — 세 곳이 같아야 한다. -->
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,1.5,13.2,13.7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#665DCAA5"
                           Geometry="M3.4,2.6 A1.1,1.1 0 0 1 4.5,1.5 H8.7 L12.6,5.4 V13.3 A1.1,1.1 0 0 1 11.5,14.4 H4.5 A1.1,1.1 0 0 1 3.4,13.3 Z" />
          <GeometryDrawing Brush="#8C0F6E56"
                           Geometry="M8.7,1.5 L12.6,5.4 H9.8 A1.1,1.1 0 0 1 8.7,4.3 Z" />
          <!-- 배지가 크면 16px 에서 문서 모양이 사라지고 '초록 동그라미'로만 읽힌다 [실측].
               문서가 드러날 만큼 줄이고, 대신 자물쇠를 굵게 그려 작은 크기에서도 남게 한다. -->
          <GeometryDrawing Brush="#0F6E56">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="11.9,11.9" RadiusX="3.3" RadiusY="3.3" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="White">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="10.55,11.75,2.7,2.3" RadiusX="0.45" RadiusY="0.45" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M11.2,11.75 V11.0 A0.7,0.7 0 0 1 12.6,11.0 V11.75">
            <GeometryDrawing.Pen>
              <Pen Brush="White" Thickness="0.75" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 암호화되지 않은 문서(.txt). 배지 대신 색과 줄무늬로 가른다 —
         평문이 여럿이어도 트리가 경고투성이가 되지 않는다.
         .txt 지원이 들어오면 위 트리 템플릿이 이 아이콘을 고른다. -->
    <DrawingImage x:Key="DocumentPlainIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- 경계 상자 통일. 이유는 FolderIcon 의 주석 참조 — 세 곳이 같아야 한다. -->
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,1.5,13.2,13.7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#8CFAC775"
                           Geometry="M3.4,2.6 A1.1,1.1 0 0 1 4.5,1.5 H8.7 L12.6,5.4 V13.3 A1.1,1.1 0 0 1 11.5,14.4 H4.5 A1.1,1.1 0 0 1 3.4,13.3 Z" />
          <GeometryDrawing Brush="#80854F0B"
                           Geometry="M8.7,1.5 L12.6,5.4 H9.8 A1.1,1.1 0 0 1 8.7,4.3 Z" />
          <GeometryDrawing Geometry="M5.6,8.4 H10.4 M5.6,10.4 H10.4 M5.6,12.4 H8.6">
            <GeometryDrawing.Pen>
              <Pen Brush="#A6854F0B" Thickness="0.9" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 트리의 "지금 키로 열리지 않음"과 탭의 "읽기 전용"은 같은 흐림이다 — 값이 두 벌이면 한쪽만 바뀐다. -->
    <sys:Double x:Key="DimmedOpacity">0.45</sys:Double>

    <!-- 탭 상태 아이콘(제목 앞). 머리글과 ▾ 목록이 함께 쓴다 — 규칙이 두 벌이 되면 한쪽만 고쳐진다.
         그림은 트리와 같은 문서 아이콘이다 — 탭만 디스크 · 자물쇠 · 종이를 쓰면 같은 파일이 두 그림으로 보였고,
         자물쇠가 트리에서는 "암호화됨", 탭에서는 "읽기 전용"이라 거꾸로 읽혔다(사용자 지적 — D-091).
         저장 상태는 그림 위에 얹는다: 저장 전 = 오른쪽 위 빨간 점 · 저장 실패 = ⚠(그림 대신) · 읽기 전용 = 트리처럼 흐리게.
         칸은 늘 16×16 이다 — 상태가 바뀌어도 탭 폭이 그대로라, 아슬아슬한 폭에서 ◀▶▾ 가 깜빡이지 않는다 [실측 — 적대 검토].
         그림은 파일 종류(IsPlainTextFile — 트리와 같은 경로 판정)로 고른다. 읽기에 실패한 .txt 도 트리처럼 평문 그림이고, 열리지 않았으니 흐리다(사용자 판정).
         흐림을 푸는 것은 읽기에 성공한 평문(IsPlainText)일 때뿐이다 — 평문의 읽기 전용은 고칠 수 없는 상태가 아니라 파일 종류다(D-025).
         뒤의 트리거가 앞을 이긴다 — 평문 트리거는 맨 뒤에 둔다. DataContext 는 탭(EditorViewModel)이다. -->
    <DataTemplate x:Key="TabStateIcon">
      <Grid Width="16" Height="16" VerticalAlignment="Center">
        <Image x:Name="Doc" Source="{StaticResource DocumentLockedIcon}"
               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
        <Viewbox x:Name="Warn" Visibility="Collapsed">
          <Grid Width="12" Height="12">
            <Path Fill="#E08A00" Data="M6,0.4 L11.7,11.3 H0.3 Z" />
            <Path Fill="White" Data="M5.35,3.8 H6.65 L6.45,7.7 H5.55 Z M5.35,8.5 H6.65 V9.8 H5.35 Z" />
          </Grid>
        </Viewbox>
        <Ellipse x:Name="Dot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Fill="#D0392B" Stroke="White" StrokeThickness="1.2" Visibility="Collapsed" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding SaveState}" Value="Saving">
          <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SaveState}" Value="Failed">
          <Setter TargetName="Doc" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Warn" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SaveState}" Value="ReadOnly">
          <Setter TargetName="Doc" Property="Opacity" Value="{StaticResource DimmedOpacity}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPlainTextFile}" Value="True">
          <Setter TargetName="Doc" Property="Source" Value="{StaticResource DocumentPlainIcon}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPlainText}" Value="True">
          <Setter TargetName="Doc" Property="Opacity" Value="1" />
          <Setter TargetName="Doc" Property="Visibility" Value="Visible" />
          <Setter TargetName="Warn" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ▾ 열린 탭 목록의 한 줄. DataContext 는 TabListEntry(탭 · 같은 제목일 때만 폴더) -->
    <DataTemplate x:Key="TabListItemTemplate">
      <StackPanel Orientation="Horizontal">
        <Grid Width="16">
          <TextBlock Text="✓" Foreground="#185FA5"
                     Visibility="{Binding Tab.IsActive, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <ContentPresenter Content="{Binding Tab}" ContentTemplate="{StaticResource TabStateIcon}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Tab.TabTitle}" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Folder}" Margin="10,0,0,0" Foreground="Gray" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <!-- 탭 줄 ◀ ▶ ▾. 포커스를 가져가지 않는다 — 넘기는 동안 본문 입력이 끊기지 않게.
         끝에 닿은 쪽은 흐리게(도구 모음 버튼 모양은 비활성 글자색만 바꾸고 그림은 그대로라). -->
    <Style x:Key="TabStripButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseActiveTabCommand}" />
    <!-- 본문 TextBox 는 F / F3 / Esc 를 쓰지 않아 창까지 온다 [실측] -->
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding OpenFindBarCommand}" />
    <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding OpenSearchWindowCommand}" />
    <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPrevCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseFindBarCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <!-- ✕ 는 트레이로 숨긴다(D-092). 진짜 종료는 이것 · 도구 모음 「종료」 · 트레이 메뉴 -->
    <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding ExitCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <ToolBar DockPanel.Dock="Top">
      <Button Content="+ 폴더"   Command="{Binding NewFolderCommand}" />
      <Button Content="+ 문서"   Command="{Binding NewDocumentCommand}" />
      <Button Content="이름변경" Command="{Binding RenameCommand}" />
      <Button Content="삭제"     Command="{Binding DeleteCommand}" />
      <Separator />
      <!-- 자동 저장이라 저장 버튼을 두지 않는다 (D-015). Ctrl+S 는 즉시 저장으로 남는다. -->
      <Button Content="전체 복사"      Command="{Binding CopyAllCommand}"    IsEnabled="{Binding Editor.CanCopy}" />
      <Button Content="열었을 때 상태 보기" Command="{Binding OpenBackupCommand}" />
      <Separator />
      <Button Content="새로고침"       Command="{Binding RefreshCommand}" />
      <Button Content="휴지통 비우기"  Command="{Binding EmptyTrashCommand}" />
      <Button Content="금고 폴더 변경" Command="{Binding ChangeRootCommand}" />
      <Separator />
      <!-- 키를 바꿔 끼우면 열리는 문서가 달라진다. 잠그기는 키를 버리고 열린 문서를 닫는다 (D-048) -->
      <Button Content="{Binding ChangeKeyLabel}" Command="{Binding ChangeKeyCommand}" />
      <Button Content="잠그기"  Command="{Binding LockCommand}" />
      <Separator />
      <Button Content="종료" Command="{Binding ExitCommand}"
              ToolTip="종료 (Ctrl+Q) — 열린 문서를 저장하고 끕니다. 키도 지워집니다" />
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom">
      <!-- 드래그 중 금지 커서만으로는 왜 안 되는지 알 수 없다. 사유를 여기에 띄운다. -->
      <TextBlock Text="{Binding DropHint}" Foreground="#B5452F" FontWeight="SemiBold" />
      <!-- 저장 여부가 어디에도 안 보이면 "저장 버튼이 반응 없다"로 느껴진다 -->
      <TextBlock Text="{Binding Editor.StatusText}" FontWeight="SemiBold" />
      <Separator />
      <!-- 지금 어느 키를 쓰는지(몇 개가 맞는지)가 안 보이면 "문서가 안 열린다"를 고장으로 읽는다 -->
      <TextBlock Text="{Binding KeyStatusText}" />
      <Separator />
      <TextBlock Text="{Binding Editor.CurrentPath}" Foreground="Gray" />
      <Separator />
      <TextBlock Text="{Binding RootPath}" Foreground="Gray" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TreeView Grid.Column="0" ItemsSource="{Binding Roots}"
                SelectedItemChanged="OnTreeSelectionChanged"
                PreviewMouseRightButtonDown="OnTreeRightClick"
                PreviewMouseLeftButtonDown="OnTreeDragStart"
                PreviewMouseMove="OnTreeDragMove"
                AllowDrop="True"
                DragOver="OnTreeDragOver"
                DragLeave="OnTreeDragLeave"
                Drop="OnTreeDrop">
        <TreeView.ContextMenu>
          <!-- TreeView 의 DataContext(ShellViewModel)를 그대로 물려받는다.
               명령은 모두 Selected 에 대해 동작하므로, 우클릭이 먼저 항목을 선택해야 한다. -->
          <ContextMenu>
            <MenuItem Header="새 폴더"   Command="{Binding NewFolderCommand}" />
            <MenuItem Header="새 문서"   Command="{Binding NewDocumentCommand}" />
            <Separator />
            <MenuItem Header="이름 변경" Command="{Binding RenameCommand}" />
            <MenuItem Header="삭제"      Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="열었을 때 상태 보기" Command="{Binding OpenBackupCommand}" />
            <Separator />
            <!-- 검색 창을 열기 전에 대상을 확정하는 가장 빠른 길 -->
            <MenuItem Header="이 폴더에서 찾기" Command="{Binding SearchInFolderCommand}" />
            <!-- "그 위치를 보러 간다"는 점에서 찾기와 같은 묶음. 폴더는 안을, 파일은 상위 폴더에서 선택해 연다 -->
            <MenuItem Header="파일 탐색기에서 열기" Command="{Binding OpenInExplorerCommand}" />
            <Separator />
            <MenuItem Header="새로고침"  Command="{Binding RefreshCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemContainerStyle>
          <!-- SelectedItem이 읽기 전용이라, 선택을 코드에서 되돌리려면 컨테이너를 묶어야 한다 -->
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <!-- 금고 문서는 확장자를 감춰 보여주므로 기호가 없으면 폴더와 문서를 구분할 방법이 없다.
               평문 파일은 이름에 확장자가 남지만, 아이콘까지 자물쇠면 "암호화된 것"으로 읽힌다 —
               세 상태가 각각 다른 그림을 받아야 한다. -->
          <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <!-- 지금 키로 열리지 않는 문서는 흐리게 — 모든 .tbx 에 자물쇠 그림이 있어 자물쇠로는 구분이 안 된다.
                 그림을 새로 두지 않아 세 아이콘의 경계 상자 규칙(D-026)은 그대로다. -->
            <StackPanel Orientation="Horizontal" ToolTip="{Binding KeyStateTip}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                      <Setter Property="Opacity" Value="{StaticResource DimmedOpacity}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                     SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Source" Value="{StaticResource DocumentLockedIcon}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                        <Setter Property="Source" Value="{StaticResource DocumentPlainIcon}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter Property="Source" Value="{StaticResource FolderIcon}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="2">
        <!-- 탭 머리글만 맡는다. 내용 영역은 비워 둔다 —
             ContentTemplate 은 TextBox 인스턴스를 하나만 만들어 돌려 써서, 본문이 같은 두 문서
             사이에 실행취소 스택이 넘어간다 [실측] (F-1). 본문은 아래 ItemsControl 이 탭마다 만든다.
             바깥 틀(TabControl 템플릿)만 다시 쓴다 — 탭이 넘쳐도 한 줄 · 넘김 · 목록 (D-074).
             TabItem 템플릿은 그대로 둔다: 머리글 ContentPresenter 가 그 안에 있어 빠뜨리면
             빌드·파싱 모두 통과하고 머리글만 빈다 (LL-014). 내용 호스트(PART_SelectedContentHost)도 남긴다 —
             부품이 빠지면 TabStrip 이 던지고, 시험(TabStripTests)이 실제 템플릿을 적용해 본다. -->
        <platform:TabStrip x:Name="TabStrip" DockPanel.Dock="Top"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    BorderThickness="0" Padding="0" Background="Transparent"
                    TabListItemTemplate="{StaticResource TabListItemTemplate}"
                    PreviewMouseLeftButtonDown="OnTabDragStart"
                    PreviewMouseMove="OnTabDragMove"
                    AllowDrop="True"
                    DragEnter="OnTabDragEnter"
                    DragOver="OnTabDragOver"
                    DragLeave="OnTabDragLeave"
                    Drop="OnTabDrop">
          <platform:TabStrip.Template>
            <ControlTemplate TargetType="platform:TabStrip">
              <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- [탭 줄 ......][◀][▶][▾] — 버튼은 오른쪽에 모은다. 넘침이 생겨도 첫 탭이 움직이지 않는다.
                     StackPanel 안의 TabPanel 은 폭 제한이 없어 접히지 않는다 [실측]. 끝 여백은 끝까지 넘겨도
                     왼쪽 끝이 온전한 탭이 되게 TabStrip 이 폭을 정한다 (D-076). -->
                <DockPanel x:Name="PART_HeaderArea" Panel.ZIndex="1" Background="Transparent">
                  <Button x:Name="PART_TabList" DockPanel.Dock="Right" ToolTip="열린 탭 목록" Style="{StaticResource TabStripButton}">
                    <Path Data="M0,0 L8,0 L4,4.5 Z" Width="8" Height="4.5" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <Button x:Name="PART_ScrollRight" DockPanel.Dock="Right" ToolTip="오른쪽으로" Style="{StaticResource TabStripButton}">
                    <Path Data="M0,0 L4.5,4.5 L0,9 Z" Width="4.5" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <Button x:Name="PART_ScrollLeft" DockPanel.Dock="Right" ToolTip="왼쪽으로" Style="{StaticResource TabStripButton}">
                    <Path Data="M4.5,0 L0,4.5 L4.5,9 Z" Width="4.5" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <ScrollViewer x:Name="PART_HeaderScroll" Focusable="False" CanContentScroll="False"
                                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                      <TabPanel x:Name="PART_HeaderPanel" IsItemsHost="True" Margin="2,2,2,0" Background="Transparent"
                                KeyboardNavigation.TabIndex="1" />
                      <Border x:Name="PART_EndSpacer" Width="0" />
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
                <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" KeyboardNavigation.DirectionalNavigation="Contained"
                        KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                    Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
              </Grid>
            </ControlTemplate>
          </platform:TabStrip.Template>
          <platform:TabStrip.ItemTemplate>
            <!-- ItemTemplate 이 없으면 머리글에 클래스 풀네임이 그대로 뜬다 (LL-016) -->
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TabStateIcon}" Margin="0,0,5,0" />
                <!-- 아주 긴 제목은 말줄임 — 줄보다 넓은 탭은 ✕ 가 안 보인다. 전체 제목은 마우스를 올리면 (D-081) -->
                <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center" MaxWidth="240"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TabTitle}" />
                <!-- 포커스를 받지 않는다 — 받으면 WPF 가 BringIntoView 를 불러, 오른쪽에 잘린 탭의 ✕ 를 누르는 순간
                     줄이 탭 하나만큼 넘어가 ✕ 가 커서 밑에서 빠진다 [실측 — 적대 검토]. 키보드로 닫기는 Ctrl+W. -->
                <Button Content="✕" Margin="8,0,0,0" Padding="4,0" FontSize="10" Focusable="False"
                        BorderThickness="0" Background="Transparent" Foreground="Gray"
                        ToolTip="탭 닫기"
                        Command="{Binding DataContext.CloseTabCommand,
                                  RelativeSource={RelativeSource AncestorType=TabControl}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </platform:TabStrip.ItemTemplate>
          <platform:TabStrip.ItemContainerStyle>
            <!-- AncestorType=TabControl 은 하위 클래스(TabStrip)도 찾는다 [실측 — 계획 검토] -->
            <Style TargetType="TabItem">
              <!-- ContextMenu 는 별도 팝업 트리라 TabControl 을 조상으로 찾지 못한다.
                   위 ✕ 버튼이 쓰는 AncestorType 관용구를 메뉴 안에 복사하면 Command 가 null 이 되고,
                   빌드·파싱·테스트·경고 0 을 전부 통과한 채 "눌러도 무반응"으로만 드러난다 [실측].
                   그래서 셸을 Tag 에 실어 PlacementTarget 경유로 건넨다. -->
              <Setter Property="Tag"
                      Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <!-- 우클릭은 탭을 선택하지 않는다 [실측]. 선택을 옮기는 대신
                       PlacementTarget.DataContext 로 우클릭한 탭을 직접 넘긴다 —
                       배경 탭을 우클릭해도 화면이 그리로 튀지 않는다. -->
                  <ContextMenu>
                    <MenuItem Header="닫기"
                              Command="{Binding PlacementTarget.Tag.CloseTabCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <!-- 파괴적인 두 항목은 구분선 아래로 내린다 — 오클릭을 줄인다 -->
                    <MenuItem Header="다른 탭 닫기"
                              Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="모든 탭 닫기"
                              Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
            </Style>
          </platform:TabStrip.ItemContainerStyle>
          <platform:TabStrip.ContentTemplate>
            <!-- 내용은 아래에서 그린다. 비워 두지 않으면 선택된 탭의 ToString() 이 노출된다 -->
            <DataTemplate>
              <Grid Height="0" />
            </DataTemplate>
          </platform:TabStrip.ContentTemplate>
        </platform:TabStrip>

        <!-- 문서 안에서 찾기. 본문을 가리지 않도록 띠로 둔다 —
             찾기 창이 찾으려는 본문을 가리는 것이 오래된 불만이다.
             DataContext 를 활성 탭으로 두면 검색창의 복사 가로채기가 그대로 붙는다. -->
        <Border DockPanel.Dock="Top" Background="#F1EFE8" Padding="8,6"
                BorderBrush="#D3D1C7" BorderThickness="0,0,0,1"
                DataContext="{Binding Editor}"
                Visibility="{Binding DataContext.IsFindBarOpen,
                             RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MatchPositionText}" Margin="10,0,4,0"
                       VerticalAlignment="Center" Foreground="Gray" MinWidth="52"
                       TextAlignment="Right" />
            <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" BorderThickness="0"
                    Background="Transparent" Foreground="Gray" ToolTip="닫기 (Esc)"
                    Command="{Binding DataContext.CloseFindBarCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />
            <CheckBox DockPanel.Dock="Right" Content="Aa" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="대소문자 구분" IsChecked="{Binding MatchCase}" />
            <Button DockPanel.Dock="Right" Content="▼" Padding="6,0" BorderThickness="0"
                    Background="Transparent" ToolTip="다음 (Enter · F3)"
                    Command="{Binding DataContext.FindNextCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button DockPanel.Dock="Right" Content="▲" Padding="6,0" BorderThickness="0"
                    Background="Transparent" ToolTip="이전 (Shift+Enter · Shift+F3)"
                    Command="{Binding DataContext.FindPrevCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBox x:Name="FindBox"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     platform:EditorBehavior.InterceptCopySelection="True"
                     IsUndoEnabled="False"
                     AllowDrop="False" Padding="4,2"
                     FontFamily="Cascadia Mono, Consolas, D2Coding" FontSize="12">
              <!-- 검색어 자체가 비밀값이다. 실행취소 스택은 새 저장소가 되고,
                   맨 TextBox 는 클립보드 기록 제외를 타지 않는다 [실측]. -->
              <TextBox.InputBindings>
                <KeyBinding Key="Enter"
                            Command="{Binding DataContext.FindNextCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                <KeyBinding Key="Enter" Modifiers="Shift"
                            Command="{Binding DataContext.FindPrevCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
        </Border>

        <Grid>
          <TextBlock Text="왼쪽에서 문서를 고르세요" Foreground="Gray" Margin="16"
                     Visibility="{Binding HasNoTabs, Converter={StaticResource BoolToVisibility}}" />

          <!-- ItemsControl 은 항목마다 컨테이너를 만든다 — 여기서 탭별 TextBox 가 생긴다.
               모두 한 칸에 겹쳐 두고 활성 탭만 보인다. 그래서 실행취소·캐럿·스크롤이 문서에 속한다. -->
          <ItemsControl x:Name="TabBodies" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                  <!-- 띠가 보이는 조건은 IsReadOnly 인데 문구는 LockReason 에 묶여 있다.
                       평문 경로가 문구를 비우면 글자 없는 붉은 띠가 그려진다 — 반드시 채운다. -->
                  <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1"
                          Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#FBECEA" />
                        <Setter Property="BorderBrush" Value="#E0B4AA" />
                        <Style.Triggers>
                          <!-- 평문은 고장이 아니라 정상 동작이다. 붉은 톤을 그대로 쓰면
                               사용자가 앱이 망가졌다고 읽는다. -->
                          <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                            <Setter Property="Background" Value="#F3F2EC" />
                            <Setter Property="BorderBrush" Value="#D9D6CA" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LockReason}" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#B5452F" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                              <Setter Property="Foreground" Value="#5F5E5A" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                           IsReadOnly="{Binding IsReadOnly}"
                           platform:EditorBehavior.InterceptCopy="True"
                           platform:SearchHighlightBehavior.ShowMatches="True"
                           AcceptsReturn="True" AcceptsTab="True"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           FontFamily="Cascadia Mono, Consolas, D2Coding" FontSize="13"
                           AllowDrop="False" Padding="10" BorderThickness="0" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
