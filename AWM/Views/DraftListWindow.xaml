<Window x:Class="AWM.Views.DraftListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="저장된 초안" Height="480" Width="720" MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="DraftList" Grid.Row="0" ItemsSource="{Binding Drafts}" SelectedItem="{Binding Selected}"
                  SelectionMode="Single" MouseDoubleClick="OnListDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="만든 날짜" Width="130"
                                    DisplayMemberBinding="{Binding Draft.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                    <GridViewColumn Header="마지막 저장 ▼" Width="130"
                                    DisplayMemberBinding="{Binding Draft.UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                    <GridViewColumn Header="제목" Width="400" DisplayMemberBinding="{Binding Draft.Title}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="열기" Command="{Binding OpenCommand}" IsDefault="True" Padding="16,4" Margin="8,0,0,0" />
                <Button Content="닫기" IsCancel="True" Padding="16,4" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Message}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#555555" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#C62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
