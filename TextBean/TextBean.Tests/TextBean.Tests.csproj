<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 이 두 줄이 없으면 테스트 프로젝트가 한 줄도 컴파일되지 않는다.
         1) ImplicitUsings는 BCL 기본 집합만 넣고 Xunit은 넣지 않는다.
            (dotnet new xunit 템플릿이 만들어 주는 Usings.cs를 우리는 쓰지 않는다)
         2) UseWPF=true 프로젝트는 암시적 using에서 System.IO를 제거한다.
            Microsoft.NET.Sdk.WindowsDesktop.WPF.props 의 <Using Remove="System.IO" /> —
            System.Windows.Shapes.Path 와 충돌하기 때문이다. -->
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextBean.csproj" />
  </ItemGroup>

</Project>
