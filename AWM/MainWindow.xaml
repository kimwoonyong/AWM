<Window x:Class="AWM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AWM — 블로그 초안" Height="720" Width="1100" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="300" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 입력 -->
        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" Text="입력" FontWeight="SemiBold" FontSize="14" />

                <TextBlock DockPanel.Dock="Top" Text="주제 (필수)" Style="{StaticResource FieldLabel}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                <TextBlock DockPanel.Dock="Top" Text="키워드 (선택)" Style="{StaticResource FieldLabel}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                <TextBlock DockPanel.Dock="Top" Text="추가 요청 (선택)" Style="{StaticResource FieldLabel}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Extra, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                         Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="초안 만들기" Command="{Binding GenerateCommand}" Padding="0,8" IsDefault="True" />
                    <Button Grid.Column="2" Content="취소" Command="{Binding CancelCommand}" Padding="16,8" />
                </Grid>

                <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" Foreground="#888888" TextWrapping="Wrap"
                           Text="주제가 비어 있거나 만드는 중이면 「초안 만들기」는 눌리지 않습니다." />
            </DockPanel>
        </Border>

        <!-- 결과 -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="네이버로 보내기" Command="{Binding SendToNaverCommand}" Padding="12,4"
                            ToolTip="본문을 네이버용으로 복사하고 크롬으로 네이버 글쓰기를 엽니다" />
                    <Button Content="네이버용 복사" Command="{Binding CopyForNaverCommand}" Padding="12,4" Margin="8,0,0,0"
                            ToolTip="소제목·인용·목록·구분선을 살린 본문을 복사합니다" />
                    <Button Content="불러오기" Command="{Binding OpenListCommand}" Padding="12,4" Margin="16,0,0,0" />
                    <Button Content="저장" Command="{Binding SaveCommand}" Padding="16,4" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="결과 — 직접 고칠 수 있습니다" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding CurrentLabel}" Foreground="#666666" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentLabel}" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1">
                <Button DockPanel.Dock="Right" Content="복사" Command="{Binding CopyTitleCommand}" Style="{StaticResource CopyButton}" />
                <TextBlock Text="제목" Style="{StaticResource FieldLabel}" />
            </DockPanel>
            <TextBox Grid.Row="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

            <DockPanel Grid.Row="3">
                <Button DockPanel.Dock="Right" Content="복사" Command="{Binding CopyBodyCommand}" Style="{StaticResource CopyButton}" />
                <TextBlock Text="본문 (## 소제목 · &gt; 인용 · - 목록 · --- 구분선)" Style="{StaticResource FieldLabel}" />
            </DockPanel>
            <TextBox Grid.Row="4" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <DockPanel Grid.Row="5">
                <TextBlock Text="태그 (본문 복사 때 맨 아래에 함께 붙습니다)" Style="{StaticResource FieldLabel}" />
            </DockPanel>
            <TextBox Grid.Row="6" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Padding="4" TextWrapping="Wrap" />
        </Grid>

        <!-- 상태 줄 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#444444" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#C62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
